# gawk 5.3.2's system() on NT: take the C library's, the way gawk itself does
# on MinGW and VMS.
#
# This is a REGRESSION 5.3.2 introduces over the 3.0.6 sibling, not something
# ntlibc lost.  3.0.6 implemented awk's system() as a plain call to the C
# library's system(), which ntlibc has and which works here.  5.3.2 replaced
# that with gawk_system(), which open-codes fork() + execl("/bin/sh", ...) so
# that it can reap the child with gawk's own wait_any() -- except on VMS and
# MinGW, where it still calls system().
#
# execl() after fork() does not work against this ntlibc pin.  Measured, with
# a nine-line C program rather than through gawk:
#
#   fork(); execl("/bin/sh", "sh", "-c", "echo child-ran", NULL)
#       -> execl returns, errno = 9 (EBADF)
#   system("echo system-ran")
#       -> prints system-ran, returns 0
#
# so gawk_system()'s child falls through to `_exit(errno == ENOENT ? 127 :
# 126)' and every system() call in an awk program returns 126 having done
# nothing.  EBADF out of exec-after-fork is the signature of the fork/cloexec
# handle bug in ntlibc -- fork() marked only the non-O_CLOEXEC handles
# OBJ_INHERIT, so the copied fd table named handles the child never got --
# which is fixed upstream in ntlibc c18edaf but is not in the revision pinned
# here.  It is below gawk either way, so this patch does not try to fix it:
# it just widens gawk's own existing escape hatch to cover this target, which
# is exactly the branch gawk takes on the other Windows C runtime it supports.
#
# _WIN32 is the condition because it is the one macro this tcc predefines
# that names this target, and because gawk 5.3.2 reads it nowhere else --
# grep finds no other use of _WIN32, WIN32 or MSDOS in any file this package
# compiles (they all live under pc/ and vms/, which it does not).  So there
# is no -U_WIN32 here of the kind coreutils needed, and no other branch moves
# when this one does.
#
# What is NOT fixed by this, and cannot be from inside gawk: `"cmd" | getline'
# and `print | "cmd"'.  io.c's gawk_popen and gawk_popen_write are the same
# fork-then-execl shape with a pipe across it, and there is no C library call
# to fall back to that gives gawk the fd it needs.  See the head of
# default.nix.
#
--- builtin.c
+++ builtin.c
@@ -3332,9 +3332,9 @@
 int
 gawk_system(const char *command)
 {
-#if defined(VMS) || defined(__MINGW32__)
+#if defined(VMS) || defined(__MINGW32__) || defined(_WIN32)
 	return system(command);
-#else /* ! (defined(VMS) || defined(__MINGW32__)) */
+#else /* ! (defined(VMS) || defined(__MINGW32__) || defined(_WIN32)) */
 	pid_t childpid;
 	int status;
 
@@ -3349,7 +3349,7 @@
 
 		return status;
 	}
-#endif /* defined(VMS) || defined(__MINGW32__) */
+#endif /* defined(VMS) || defined(__MINGW32__) || defined(_WIN32) */
 }
 
 #if 0
