${ar} rc libbackend.a insn-attrtab.o insn-automata.o insn-emit.o insn-extract.o insn-modes.o insn-opinit.o insn-output.o insn-peep.o insn-preds.o insn-recog.o insn-enums.o ggc-page.o alias.o alloc-pool.o auto-inc-dec.o bb-reorder.o bitmap.o bt-load.o builtins.o caller-save.o calls.o cfg.o cfganal.o cfgbuild.o cfgcleanup.o cfgexpand.o cfghooks.o cfglayout.o cfgloop.o cfgloopanal.o cfgloopmanip.o cfgrtl.o combine.o combine-stack-adj.o compare-elim.o convert.o coverage.o cse.o cselib.o dbxout.o dbgcnt.o dce.o ddg.o debug.o df-core.o df-problems.o df-scan.o dfp.o diagnostic.o dojump.o dominance.o domwalk.o double-int.o dse.o dwarf2asm.o dwarf2out.o ebitmap.o emit-rtl.o et-forest.o except.o explow.o expmed.o expr.o final.o fixed-value.o fold-const.o function.o fwprop.o gcse.o ggc-common.o gimple.o gimple-iterator.o gimple-fold.o gimple-low.o gimple-pretty-print.o gimplify.o godump.o graph.o graphds.o graphite.o graphite-blocking.o graphite-clast-to-gimple.o graphite-cloog-util.o graphite-dependences.o graphite-flattening.o graphite-interchange.o graphite-poly.o graphite-ppl.o graphite-scop-detection.o graphite-sese-to-poly.o gtype-desc.o haifa-sched.o hooks.o hwint.o ifcvt.o implicit-zee.o init-regs.o input.o integrate.o intl.o ira.o ira-build.o ira-costs.o ira-conflicts.o ira-color.o ira-emit.o ira-lives.o jump.o langhooks.o lcm.o lists.o loop-doloop.o loop-init.o loop-invariant.o loop-iv.o loop-unroll.o loop-unswitch.o lower-subreg.o lto-cgraph.o lto-streamer-in.o lto-streamer-out.o lto-section-in.o lto-section-out.o lto-symtab.o lto-opts.o lto-streamer.o lto-compress.o mcf.o mode-switching.o modulo-sched.o omega.o omp-low.o optabs.o options.o opts-common.o opts-global.o opts.o params.o passes.o plugin.o pointer-set.o postreload-gcse.o postreload.o predict.o pretty-print.o print-rtl.o print-tree.o profile.o real.o realmpfr.o recog.o reg-stack.o regcprop.o reginfo.o regmove.o regrename.o regstat.o reload.o reload1.o reorg.o resource.o rtl-error.o rtl.o rtlanal.o rtlhooks.o sbitmap.o sched-deps.o sched-ebb.o sched-rgn.o sched-vis.o sdbout.o sel-sched-ir.o sel-sched-dump.o sel-sched.o sese.o simplify-rtx.o sparseset.o sreal.o stack-ptr-mod.o statistics.o stmt.o stor-layout.o store-motion.o stringpool.o target-globals.o targhooks.o timevar.o toplev.o tracer.o tree-affine.o tree-call-cdce.o tree-cfg.o tree-cfgcleanup.o tree-chrec.o tree-complex.o tree-data-ref.o tree-dfa.o tree-diagnostic.o tree-dump.o tree-eh.o tree-emutls.o tree-if-conv.o tree-into-ssa.o tree-iterator.o tree-loop-distribution.o tree-nested.o tree-nrv.o tree-object-size.o tree-optimize.o tree-outof-ssa.o tree-parloops.o tree-phinodes.o tree-predcom.o tree-pretty-print.o tree-profile.o tree-scalar-evolution.o tree-sra.o tree-switch-conversion.o tree-ssa-address.o tree-ssa-alias.o tree-ssa-ccp.o tree-ssa-coalesce.o tree-ssa-copy.o tree-ssa-copyrename.o tree-ssa-dce.o tree-ssa-dom.o tree-ssa-dse.o tree-ssa-forwprop.o tree-ssa-ifcombine.o tree-ssa-live.o tree-ssa-loop-ch.o tree-ssa-loop-im.o tree-ssa-loop-ivcanon.o tree-ssa-loop-ivopts.o tree-ssa-loop-manip.o tree-ssa-loop-niter.o tree-ssa-loop-prefetch.o tree-ssa-loop-unswitch.o tree-ssa-loop.o tree-ssa-math-opts.o tree-ssa-operands.o tree-ssa-phiopt.o tree-ssa-phiprop.o tree-ssa-pre.o tree-ssa-propagate.o tree-ssa-reassoc.o tree-ssa-sccvn.o tree-ssa-sink.o tree-ssa-structalias.o tree-ssa-ter.o tree-ssa-threadedge.o tree-ssa-threadupdate.o tree-ssa-uncprop.o tree-ssa-uninit.o tree-ssa.o tree-ssanames.o tree-stdarg.o tree-tailcall.o tree-vect-generic.o tree-vect-patterns.o tree-vect-data-refs.o tree-vect-stmts.o tree-vect-loop.o tree-vect-loop-manip.o tree-vect-slp.o tree-vectorizer.o tree-vrp.o tree.o value-prof.o var-tracking.o varasm.o vec.o version.o vmsdbgout.o web.o xcoffout.o i386.o winnt.o winnt-stubs.o host-default.o cgraph.o cgraphbuild.o cgraphunit.o cppbuiltin.o cppdefault.o incpath.o ipa-cp.o ipa-split.o ipa-inline.o ipa-prop.o ipa-pure-const.o ipa-reference.o ipa-ref.o ipa-struct-reorg.o ipa-type-escape.o ipa-utils.o ipa.o matrix-reorg.o prefix.o tree-inline.o tree-nomudflap.o varpool.o

# --- cc1-checksum.o: package-owned stand-in, see shim/cc1-checksum.c's own
# header for why a hand-written dummy is correct here, not genchecksum output. ---
CC -o cc1-checksum.o ${cc1ChecksumC}

# nt-rpath.c: gcc/plugin.c (an unconditional libbackend.a member, real
# GCC plugin support -- never exercised by this bootstrap, but plugin.c
# calls dlopen() unconditionally at file scope regardless) needs the
# same __rpath symbol every ntlibc program that touches dlopen does --
# see nt-rpath.c's own header, byte-for-byte the same fix
# ../binutils/nt-rpath.c already found for bfd/plugin.c's identical shape.
CC -o nt-rpath.o ${ntRpathC}

# --- link cc1.exe: C_OBJS + cc1-checksum.o + main.o + nt-rpath.o +
# libbackend.a + libcpp.a + libdecnumber.a + libiberty.a + gmp/mpfr/mpc +
# zlib -- real link line from generated/cc1-link.txt section 2
# (make3.log:67256-67257), with nt-rpath.o added (not part of any real
# GCC build -- an ntlibc-specific necessity, same as binutils' own). ---
${tcc} -B ${ntlibc}/lib -nostdlib ${ntlibc}/lib/crt1.o -o cc1.exe c-lang.o c-family/stub-objc.o attribs.o c-errors.o c-decl.o c-typeck.o c-convert.o c-aux-info.o c-objc-common.o c-parser.o tree-mudflap.o c-family/c-common.o c-family/c-cppbuiltin.o c-family/c-dump.o c-family/c-format.o c-family/c-gimplify.o c-family/c-lex.o c-family/c-omp.o c-family/c-opts.o c-family/c-pch.o c-family/c-ppoutput.o c-family/c-pragma.o c-family/c-pretty-print.o c-family/c-semantics.o c-family/c-ada-spec.o i386-c.o msformat-c.o cc1-checksum.o main.o nt-rpath.o libbackend.a libcpp.a libdecnumber.a libiberty.a -L . -lmpc -lmpfr -lgmp -lz -L ${ntlibc}/lib -lc -lntdll

# --- link gcc.exe (the driver): real object list from 5c4abbd's own driver-object
# audit, cross-checked against gcc/Makefile.in's GCC_OBJS. Shares diagnostic.o/
# pretty-print.o/input.o/vec.o/version.o/intl.o/prefix.o with libbackend.a's own
# members -- the same physical .o files, not recompiled, exactly like real GCC's
# own Makefile links them into both cc1 (via libbackend.a) and gcc (directly). ---
${tcc} -B ${ntlibc}/lib -nostdlib ${ntlibc}/lib/crt1.o -o gcc.exe gcc.o opts-common.o gcc-options.o diagnostic.o pretty-print.o input.o vec.o ggc-none.o gccspec.o driver-i386.o version.o intl.o prefix.o libcpp.a libdecnumber.a libiberty.a -L ${ntlibc}/lib -lc -lntdll


# --- prove cc1.exe actually works, same bar as every other package in this
# chain: not "the derivation succeeded" or "it linked", but "it runs and
# does its actual job". ---
./cc1.exe --version

# A trivial, freestanding-callable C program -- no libc dependency beyond
# what ntlibc's own crt1.o/libc.a provide once linked.
${bin_cp} ${helloC} hello.c

# cc1.exe's real job: -o hello.s hello.c, taking a real C source file
# straight to i386 GNU-syntax assembly. cc1 invoked directly (not through
# gcc.exe's own spec-driven -isystem/-I machinery, not exercised by this
# package's own functional test -- see default.nix's "What this package
# does NOT attempt") needs ntlibc's own include dirs named explicitly,
# the same three -I's every CC* alias above already uses.
./cc1.exe -quiet -nostdinc -I${ntlibcSrc}/include -I${ntlibcSrc}/arch/i386 -I${ntlibcSrc}/arch/generic -I${ntlibc}/include -o hello.s hello.c

# Assemble and link with THIS CHAIN'S OWN tcc, not binutils' real as.exe/
# ld.exe -- see ../binutils/default.nix's own "ntlibc's crt1.o/libc.a are
# ELF, not COFF" section: a real GNU ld cannot link ntlibc's own runtime
# objects at all (they are tcc's internal ELF relocatables, not COFF), and
# 9518ca7 already found tcc's own linker cannot consume a real `as`-
# assembled COFF object either -- neither direction bridges the gap, a
# real, already-reported interface boundary, not something to route around
# quietly here. Staying inside tcc end-to-end (its own integrated
# assembler front end reads cc1's .s output the same way it reads its own
# -S output, then its own PE linker links the result against ntlibc's real
# ELF-relocatable crt1.o/libc.a, exactly the same recipe binutils.exe
# links against for its own compiles) avoids the gap entirely rather than
# working around it -- this is the one path this chain has actually
# verified end to end, for every package before this one.
${tcc} -B ${ntlibc}/lib -nostdlib ${ntlibc}/lib/crt1.o -o hello.exe hello.s -L . -lgcc -L ${ntlibc}/lib -lc -lntdll

# And run it under the real PE32 loader (via this chain's own wine fork,
# WINEDEBUG/WINEDLLOVERRIDES already set by the environment this build runs
# in -- see [[winedbg-popup-trap]]): a C program compiled by this chain's
# own from-scratch cc1.exe, assembled and linked by this chain's own tcc,
# actually running and exiting 0 on real NT semantics. kaem --strict fails
# the whole build on a nonzero exit, so a silent pass here is a real one.
./hello.exe

${bin_mkdir} -p ${out}/bin
${bin_cp} cc1.exe ${out}/bin/cc1.exe
${bin_cp} gcc.exe ${out}/bin/gcc.exe

# gcc.exe's own driver (gcc.c) does not look for cc1 next to itself in
# bin/ -- it searches STANDARD_LIBEXEC_PREFIX/STANDARD_EXEC_PREFIX, each
# joined with DEFAULT_TARGET_MACHINE/DEFAULT_TARGET_VERSION
# (add_prefix's own require_machine_suffix=1 case, gcc.c:3872-3874 for
# libexec, :3877 for exec/BINUTILS), well before it ever falls back to a
# bare PATH search for the literal string "cc1". Installed under both --
# libexec first (checked first, real GCC's own modern convention) and
# lib/gcc as a second copy (BINUTILS-component fallback path also reaches
# it) -- cheaper than getting gcc_exec_prefix's own argv[0]-relocation
# logic exactly right for a nix store path that never sits at a fixed
# offset from its own bin/ the way a traditional --prefix install does.
${bin_mkdir} -p ${out}/libexec/gcc/i686-pc-pe/4.6.4
${bin_cp} cc1.exe ${out}/libexec/gcc/i686-pc-pe/4.6.4/cc1.exe
${bin_mkdir} -p ${out}/lib/gcc/i686-pc-pe/4.6.4
${bin_cp} cc1.exe ${out}/lib/gcc/i686-pc-pe/4.6.4/cc1.exe

# libgcc.a itself: this package's own build already links cc1.exe/gcc.exe
# straight from the .o's (never through this archive -- see the "link
# cc1.exe" line below, which lists lg_*.o directly, not libgcc.a), so
# installing the archive is new here, not something the two links above
# needed. A consumer of this package as a stdenv (any later package's own
# -lgcc) does need it, though, and this is the same exec-prefix cc1.exe
# and as.exe already install to.
${bin_cp} libgcc.a ${out}/lib/gcc/i686-pc-pe/4.6.4/libgcc.a

# gcc.exe's own "assemble" spec step (gcc.c's default_compilers table,
# the ".s"/"@assembler" rule) spawns a program literally named "as",
# searched through the same exec_prefixes cc1 was -- see 9518ca7/63d15d7
# for why this chain's own tcc is AS_FOR_TARGET, not a real GNU as (the
# ELF/COFF split ../binutils/default.nix documents -- confirmed directly
# again in this package's own session: a real assembled COFF .o from
# ../binutils's own as.exe genuinely fails to link with this chain's tcc,
# "unrecognized file type", so real as.exe cannot stand in for the
# assemble step either, despite not touching libc.a itself). This
# chain's own tcc already accepts a .s file as direct input the exact
# same way it accepts .c (dispatched by extension, no separate
# "assembler mode" needed -- already proven by this package's own
# functional test above, `tcc ... hello.s`), so installing this chain's
# own tcc binary itself, under the name "as.exe", at the same two
# exec-prefix locations cc1.exe already lives at, is the right shape --
# no wrapper script needed or possible (this build produces only real PE
# binaries, no shell interpreter). Installed and exercised up to the
# point cc1 hands off to it (confirmed: gcc.exe's driver correctly finds
# and would exec this "as.exe") -- but NOT yet proven to actually
# assemble anything end to end through the driver: see the real,
# separate, still-open gap this session found below.
${bin_cp} ${tcc} ${out}/libexec/gcc/i686-pc-pe/4.6.4/as.exe
${bin_cp} ${tcc} ${out}/lib/gcc/i686-pc-pe/4.6.4/as.exe

# --- prove the DRIVER itself works, not just cc1 invoked directly: a
# real `gcc.exe hello2.c -o hello2.exe`-shaped invocation has to find and
# exec cc1 on its own. Stops at -S (cc1 only) rather than -c (cc1 then
# "as") -- see hello3's own comment below for why -c is not attempted
# here yet, a real, separate, still-open gap. gcc.exe still cannot
# invoke a real `ld` either (neither ../binutils's own -- the ELF/COFF
# split -- nor does this bootstrap teach its specs about this chain's
# own tcc as a stand-in linker, a bigger question than the assembler
# one: tcc's own -o/link behavior differs enough from a real spec-driven
# ld invocation, crt1.o/-lc/-lntdll placement and all, that getting
# LINK_SPEC right is real, separate work -- see "What this package does
# NOT attempt" in default.nix). Full compile+link is already proven
# above, through cc1 and tcc invoked directly. ---
${bin_cp} ${helloC} hello2.c
${out}/bin/gcc.exe -B ${out}/lib/gcc/i686-pc-pe/4.6.4/ -B ${out}/libexec/gcc/i686-pc-pe/4.6.4/ -I ${ntlibcSrc}/include -I ${ntlibcSrc}/arch/i386 -I ${ntlibcSrc}/arch/generic -I ${ntlibc}/include -S hello2.c -o hello2.s

# --- and the real usability bar: `gcc.exe foo.c` with NO -B, NO -I at
# all, invoked from its own installed ${out}/bin -- both the exec-prefix
# search (STANDARD_LIBEXEC_PREFIX/STANDARD_EXEC_PREFIX, already installed
# to above) and the CROSS_INCLUDE_DIR/TOOL_INCLUDE_DIR defaults (this
# package's own fixes) have to work together with zero flags, the way a
# caller who has never read this package's own build.kaem would actually
# invoke it. hello.c's own #include <unistd.h> resolves through
# CROSS_INCLUDE_DIR/TOOL_INCLUDE_DIR alone since neither it nor
# bits/alltypes.h lives under arch/.
#
# Still -S here, not -c: -c (cc1 piping through a real intermediate .s
# file to "as") was tried and found a real, separate, NOT-yet-solved
# bug, investigated directly rather than worked around blindly --
# libiberty's own make_temp_file() (choose_tmpdir + mkstemps(), the
# windows.patch-neutralized POSIX branch every ntlibc program already
# uses) is handed a real Windows-notation path by wine's own auto-set
# TMP/TEMP env vars (e.g. "C:\users\<u>\AppData\Local\Temp\ccXXXXXX.s"),
# and gcc.exe's driver goes on to invoke "as.exe" with that exact path
# with no error reported -- but the file is never actually created
# there (confirmed directly: the real host directory behind that wine
# path stays empty after the run, and "as.exe" then correctly reports
# it missing). This is NOT a general Windows-path problem -- a direct,
# isolated ntlibc fopen() test against the exact same path (both
# backslash-only and the mixed-separator form GCC's own temp-path
# construction actually produces) succeeds and writes a real file every
# time, confirmed directly. Setting TMPDIR explicitly to a real
# host-style path ahead of TMP/TEMP in choose_tmpdir's own search order
# did not change the outcome either. The gap is therefore somewhere more
# specific -- inside mkstemps()'s own file-creation path as gcc-core's
# bundled libiberty actually calls it, or in how that env var reaches
# the process under this chain's own wine invocation -- not yet
# root-caused to a single line, and not something to route around
# quietly (this could plausibly be a real ntlibc gap, in which case it
# is ntlibc-coordination's "report, don't patch" territory, not
# something for this package to paper over). Left open, reported here
# rather than forced through under time pressure; hello3.c below still
# proves the zero-flag CROSS_INCLUDE_DIR/TOOL_INCLUDE_DIR defaults work,
# just stops at -S rather than chasing -c's real bug further. ---
${bin_cp} ${helloC} hello3.c
${out}/bin/gcc.exe -S hello3.c -o hello3.s
