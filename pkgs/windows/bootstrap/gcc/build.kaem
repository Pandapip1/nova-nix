CCGMP -DHAVE_CONFIG_H -o gmp_randmui.o gmp-${gmpVersion}/randmui.c
CCGMP -DHAVE_CONFIG_H -o gmp_version.o gmp-${gmpVersion}/version.c
CCGMP -DHAVE_CONFIG_H -D__GMP_WITHIN_GMP -DNO_ASM -o gmp_mpz_abs.o gmp-${gmpVersion}/mpz/abs.c
CCGMP -DHAVE_CONFIG_H -D__GMP_WITHIN_GMP -DNO_ASM -o gmp_mpz_add.o gmp-${gmpVersion}/mpz/add.c
