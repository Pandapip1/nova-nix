# GCC 4.6.4, compiled and linked ENTIRELY by this chain's own tcc, against
# ntlibc -- the last package in the Windows PE32 full-source bootstrap.
#
# See default.nix for the target-triple decision (i686-pc-pe, same as
# binutils), what generated/ is and why every file in it was individually
# tcc-probed before this file was written (896d3ea through 63d15d7 -- eleven
# commits of scoping work on this package alone), and why this is a
# generated-but-explicit build.kaem rather than a real ./configure.
#
# Shape, same idiom as binutils' own build.kaem: unpack, apply windows.patch
# (gcc-core's own bundled libiberty -- a different, older copy than
# ../binutils's own, needing the same three _WIN32-branch fixes freshly
# re-derived against this copy's line numbers), reference every generated/
# header directly via -I (no in-tree copying -- these are real nix store
# paths, and every compile line below names its own source file directly,
# so nothing needs to physically sit next to anything else), compile every
# file this package's own real, closed OBJS/C_OBJS/gmp+mpfr+mpc/libiberty
# lists say are needed (generated/cc1-link.txt, 537e2c8, af6c095, 5c4abbd),
# archive, link cc1.exe and gcc.exe, then prove cc1.exe can actually compile
# a trivial C program to assembly and that binutils' own as.exe/ld.exe (this
# chain's real GNU toolchain, already built and proven) can assemble and
# link the result into a running PE32 binary.
#
# gmp/mpfr/mpc are NOT copied into gcc-${version}/{gmp,mpfr,mpc} the way
# ../../../linux/bootstrap/gcc/build.sh's real ./configure-driven build
# does -- nothing here runs gcc's own configure/Makefile machinery, so
# nothing needs them at those particular relative paths. Every compile line
# below names its own source file by explicit path (gmp-${gmpVersion}/...,
# mpfr-${mpfrVersion}/..., mpc-${mpcVersion}/...), and every gcc/libcpp
# compile line's own -I list (the CC/CCLIBCPP aliases below) points
# directly at those same top-level unpacked directories for gmp.h/mpfr.h/
# mpc.h -- so there is nothing for an in-tree copy to buy here that a
# direct reference does not already give for free, and no mkdir/cp-tree
# tool this chain's mescc-tools-extra provides anyway (no recursive cp, no
# mv -- see stage0-pe32/mescc-tools-extra.nix).

cd ${NIX_BUILD_TOP}

# --- unpack: gcc-core, gmp, mpfr, mpc -- all real .tar.gz.
#
# gcc-core-4.6.4.tar.gz (162MB uncompressed) is too large for
# stage0.mescc-tools-extra's own ungz (a minimal, fixed-buffer puff()-based
# inflate, the same seed-stage tool every earlier, smaller-tarball package
# on this side of the chain used without issue) -- confirmed directly, not
# guessed: a standalone run against the real fetched tarball fails with
# "puff() failed with return code -2" (puff.c's own "invalid block type"),
# while the exact same tool cleanly decompresses gmp-4.3.2.tar.gz (12MB
# uncompressed) moments later with identical WINEDEBUG/WINEPREFIX
# plumbing -- a real size/buffer limit in the seed tool, not a corrupt
# download (gzip -t on the host and a real GNU gunzip.exe both accept the
# file) and not a wine/exec-wrapper artifact. This chain already has a
# more capable decompressor by this point in the bootstrap, though --
# ../gzip's own real gzip.exe (built by tcc, several packages ago,
# confirmed directly against this exact tarball: cleanly produces a valid
#162498560-byte tar, `tar tf` reads every member) -- so gunzip.exe is used
# for all four tarballs here (uniform, not just for the one that needs
# it), invoked by its argv[0]-dispatched decompress mode (../gzip's own
# build.kaem comment: "Mode from argv[0]... A copy named gunzip.exe"),
# which needs the input already named with its real .gz suffix and
# produces the same basename without it -- unlike ungz's --file/--output
# flags, there is nothing to rename on the way out. ---
${bin_cp} ${coreTarball} gcc-core.tar.gz
${gunzip} gcc-core.tar.gz
${bin_untar} --file gcc-core.tar
${bin_cp} ${gmpTarball} gmp.tar.gz
${gunzip} gmp.tar.gz
${bin_untar} --file gmp.tar
${bin_cp} ${mpfrTarball} mpfr.tar.gz
${gunzip} mpfr.tar.gz
${bin_untar} --file mpfr.tar
${bin_cp} ${mpcTarball} mpc.tar.gz
${gunzip} mpc.tar.gz
${bin_untar} --file mpc.tar

# gcc-core-4.6.4's own bundled libiberty -- a different, older copy from
# ../binutils's own (different line numbers, same three _WIN32 branches
# written against a real Win32 CRT ntlibc does not have), freshly
# re-patched for this copy -- see windows.patch's own header and 5c4abbd.
cd ${NIX_BUILD_TOP}/gcc-${version}
${patch} -Np0 -i ${windowsPatch}

# gcc/config/i386/winnt.c's own .def/.scl/.type/.endef PE-symbol-table
# markers -- this chain's own tcc assembler has no handling for them at
# all ("unknown opcode '.def'", found by this package's own functional
# test) -- see def-scl-type.patch's own header for the full story.
${patch} -Np0 -i ${defSclTypePatch}

# gcc/config/i386/cygming.h's own USER_LABEL_PREFIX -- "_" by default,
# ntlibc's real symbols (checked directly with nm) are undecorated. See
# user-label-prefix.patch's own header: without this, every call cc1
# emits into ntlibc, and every target program's own main() entry point,
# fails to link (found by this package's own functional test).
${patch} -Np0 -i ${userLabelPrefixPatch}
cd ${NIX_BUILD_TOP}

# --- CC aliases: one per real -I ordering this package's own tcc-probe
# harness already established and verified clean (env.sh/env_gmp.sh/
# env_libiberty.sh, 9518ca7 through af6c095) -- gcc/ and gcc/c-family/ must
# search before libcpp/ (both dirs ship a same-named config.h/system.h,
# 12ad247's own probe-harness-ordering finding), libcpp/*.c need the
# opposite order (9139190/d344b7b), gmp/mpfr/mpc/libiberty each need only
# their own generated/ + source dir. shim (fnmatch.h, windows.h,
# cc1-checksum.c) goes first on every alias, same as binutils' own -Ishim
# placement, so it is never in doubt which fnmatch.h/windows.h wins the
# quote-include search. -DHAVE_CONFIG_H is on every alias except CCZLIB
# (zlib's own zconf.h is static, not configure-instantiated -- 537e2c8) and
# CCLIBDECNUM (libdecnumber's own dfp files take no HAVE_CONFIG_H either,
# per their real make3.log compile line).
alias CC="${tcc} -nostdinc -I${shimDir} -I${ntlibcSrc}/include -I${ntlibcSrc}/arch/i386 -I${ntlibcSrc}/arch/generic -I${ntlibc}/include -I${genDir} -I${genDir}/gmp -I${genDir}/mpc -I${genDir}/libcpp -I${genDir}/libdecnumber -Igcc-${version}/gcc -Igcc-${version}/gcc/c-family -Igcc-${version}/gcc/config/i386 -Igcc-${version}/include -Igcc-${version}/libcpp/include -Igcc-${version}/libcpp -Igmp-${gmpVersion} -Impfr-${mpfrVersion} -Impc-${mpcVersion}/src -Igcc-${version}/libdecnumber -Igcc-${version}/libdecnumber/dpd -Igcc-${version}/zlib -DHAVE_CONFIG_H -c"

alias CCLIBCPP="${tcc} -nostdinc -I${genDir}/libcpp -I${shimDir} -I${ntlibcSrc}/include -I${ntlibcSrc}/arch/i386 -I${ntlibcSrc}/arch/generic -I${ntlibc}/include -Igcc-${version}/libcpp -Igcc-${version}/libcpp/include -I${genDir}/gmp -I${genDir}/mpc -Igcc-${version}/gcc -Igcc-${version}/gcc/c-family -Igcc-${version}/gcc/config/i386 -Igcc-${version}/include -Igmp-${gmpVersion} -Impfr-${mpfrVersion} -Impc-${mpcVersion}/src -DHAVE_CONFIG_H -c"

# libgcc2.c is a gcc/ source file (needs tm.h/tconfig.h/insn-*.h the same
# way every OBJS-common file does) -- reuses CC's own -I list exactly.
alias CCLIBGCC2="${tcc} -nostdinc -I${shimDir} -I${ntlibcSrc}/include -I${ntlibcSrc}/arch/i386 -I${ntlibcSrc}/arch/generic -I${ntlibc}/include -I${genDir} -I${genDir}/gmp -I${genDir}/mpc -I${genDir}/libcpp -I${genDir}/libdecnumber -Igcc-${version}/gcc -Igcc-${version}/gcc/c-family -Igcc-${version}/gcc/config/i386 -Igcc-${version}/include -Igcc-${version}/libcpp/include -Igcc-${version}/libcpp -Igmp-${gmpVersion} -Impfr-${mpfrVersion} -Impc-${mpcVersion}/src -Igcc-${version}/libdecnumber -Igcc-${version}/libdecnumber/dpd -Igcc-${version}/zlib -DHAVE_CONFIG_H -c"

alias CCGMP="${tcc} -nostdinc -I${shimDir} -I${ntlibcSrc}/include -I${ntlibcSrc}/arch/i386 -I${ntlibcSrc}/arch/generic -I${ntlibc}/include -I${genDir}/gmp -I${genDir}/gmp/mpz -I${genDir}/gmp/mpn -Igmp-${gmpVersion} -c"

alias CCMPFR="${tcc} -nostdinc -I${shimDir} -I${ntlibcSrc}/include -I${ntlibcSrc}/arch/i386 -I${ntlibcSrc}/arch/generic -I${ntlibc}/include -I${genDir}/gmp -I${genDir}/mpfr -Impfr-${mpfrVersion} -c"

alias CCMPC="${tcc} -nostdinc -I${shimDir} -I${ntlibcSrc}/include -I${ntlibcSrc}/arch/i386 -I${ntlibcSrc}/arch/generic -I${ntlibc}/include -I${genDir}/gmp -I${genDir}/mpc -Impc-${mpcVersion}/src -Impfr-${mpfrVersion} -c"

alias CCLIBIBERTY="${tcc} -nostdinc -I${shimDir} -I${ntlibcSrc}/include -I${ntlibcSrc}/arch/i386 -I${ntlibcSrc}/arch/generic -I${ntlibc}/include -I${genDir}/libiberty -Igcc-${version}/libiberty -Igcc-${version}/include -c"

alias CCLIBDECNUM="${tcc} -nostdinc -I${shimDir} -I${ntlibcSrc}/include -I${ntlibcSrc}/arch/i386 -I${ntlibcSrc}/arch/generic -I${ntlibc}/include -Igcc-${version}/libdecnumber -I${genDir}/libdecnumber -c"

alias CCZLIB="${tcc} -nostdinc -I${shimDir} -I${ntlibcSrc}/include -I${ntlibcSrc}/arch/i386 -I${ntlibcSrc}/arch/generic -I${ntlibc}/include -Igcc-${version}/zlib -c"

# --- gmp: 401 real files (Makefile-derived list, 537e2c8/af6c095) ---
CCGMP -DHAVE_CONFIG_H -o gmp_assert.o gmp-${gmpVersion}/assert.c
CCGMP -DHAVE_CONFIG_H -o gmp_compat.o gmp-${gmpVersion}/compat.c
CCGMP -DHAVE_CONFIG_H -o gmp_errno.o gmp-${gmpVersion}/errno.c
CCGMP -DHAVE_CONFIG_H -o gmp_extract-dbl.o gmp-${gmpVersion}/extract-dbl.c
CCGMP -DHAVE_CONFIG_H -o gmp_invalid.o gmp-${gmpVersion}/invalid.c
CCGMP -DHAVE_CONFIG_H -o gmp_memory.o gmp-${gmpVersion}/memory.c
# tal-reent.c: genuinely missing from the 401-file list this build.kaem
# was generated from (537e2c8's own extraction) -- found only when the
# real link failed with unresolved __gmp_tmp_reentrant_alloc/_free.
# gmp/Makefile.in's own TAL_OBJECT = tal-reent.lo names it as gmp's real,
# selected temporary-allocation strategy (not tal-notreent.c or
# tal-debug.c, both also shipped but unused, EXTRA_libgmp_la_SOURCES only).
