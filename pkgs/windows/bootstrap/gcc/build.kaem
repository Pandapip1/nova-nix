# --- driver-only objects: gcc.o/gccspec.o (not in the 372-file probe list --
# 5c4abbd found both missing from extraction, real flags recovered from
# make3.log directly), plus opts-common.o/ggc-none.o (already-probed 372-file
# members that cc1 itself does not use) and gcc-options.o (options.c compiled
# a second time with -DGCC_DRIVER, gcc/Makefile.in's own rule). ---
# opts-common.o already compiled above as a libbackend.a member (gcc/Makefile.in's
# own OBJS-common includes it too) -- the driver reuses that same object file,
# not a second compile, matching real GCC's own Makefile (see 5c4abbd).
CC -DIN_GCC -DCROSS_DIRECTORY_STRUCTURE -DHAVE_CONFIG_H -o ggc-none.o gcc-${version}/gcc/ggc-none.c
CC -DIN_GCC -DCROSS_DIRECTORY_STRUCTURE -DHAVE_CONFIG_H -DGCC_DRIVER -o gcc-options.o ${genDir}/options.c
# ASM_SPEC="-c": gcc.c's own default_compilers table invokes the found
# "as" binary as `as %(asm_debug) %(asm_options) input -o output` with no
# extra flags by default for this target (mingw32.h/cygming.h/i386.h
# never #define ASM_SPEC, gcc.c's own #ifndef ASM_SPEC / #define
# ASM_SPEC "" fallback applies) -- real GNU as would treat that as
# "assemble", but this chain's own tcc (installed above as "as.exe")
# needs -c to mean the same thing; without it tcc's own default (no -c,
# an -o target) tries to LINK a standalone executable from one .s file,
# not produce a relocatable object. Set directly on gcc.c's own compile
# line (the only file that reads ASM_SPEC, gcc.c:472-475) rather than as
# a real target-header #define, since it is a property of THIS chain's
# stand-in assembler, not of the i386-pe/cygming target as GCC itself
# understands it.
CC -DIN_GCC -DCROSS_DIRECTORY_STRUCTURE -DASM_SPEC=\"-c\" -DSTANDARD_STARTFILE_PREFIX=\"../../../\" -DSTANDARD_EXEC_PREFIX=\"${out}/lib/gcc/\" -DSTANDARD_LIBEXEC_PREFIX=\"${out}/libexec/gcc/\" -DDEFAULT_TARGET_VERSION=\"4.6.4\" -DDEFAULT_TARGET_MACHINE=\"i686-pc-pe\" -DSTANDARD_BINDIR_PREFIX=\"${out}/bin/\" -DTOOLDIR_BASE_PREFIX=\"../../../../\" -DCONFIGURE_SPECS=\"\" -o gcc.o gcc-${version}/gcc/gcc.c
CC -DIN_GCC -DCROSS_DIRECTORY_STRUCTURE -DSTANDARD_STARTFILE_PREFIX=\"../../../\" -DSTANDARD_EXEC_PREFIX=\"${out}/lib/gcc/\" -DSTANDARD_LIBEXEC_PREFIX=\"${out}/libexec/gcc/\" -DDEFAULT_TARGET_VERSION=\"4.6.4\" -DDEFAULT_TARGET_MACHINE=\"i686-pc-pe\" -DSTANDARD_BINDIR_PREFIX=\"${out}/bin/\" -DTOOLDIR_BASE_PREFIX=\"../../../../\" -DCONFIGURE_SPECS=\"\" -o gccspec.o gcc-${version}/gcc/gccspec.c

# driver-i386.c: gccspec.c's own -march=native support calls
# host_detect_local_cpu, defined here -- genuinely missing from this
# package's own driver-object list (5c4abbd's own audit of gcc.c/
# gccspec.c never turned this file up; found only once gcc.exe's own
# link failed wanting it, real flags from make3.log:66431).
CC -DIN_GCC -DCROSS_DIRECTORY_STRUCTURE -o driver-i386.o gcc-${version}/gcc/config/i386/driver-i386.c
# --- libgcc: the DImode helper subset this bootstrap's own build actually
# needs (tcc's own 64-bit codegen per gen_opl in tccgen.c, and cc1's generated
# code once it exists) -- 9518ca7/9386c7c already tcc-verified these 19 L_*
# compile units from gcc's own libgcc2.c. The remaining lib2funcs (negdi2,
# ctors, __main, clz/ctz/popcount/parity, powi, the 8 C99 _Complex funcs -- see
# generated/cc1-link.txt section 4 for why those are excluded) are not built:
# nothing in this bootstrap's own closed source (gcc/gmp/mpfr/mpc/libiberty/
# libcpp, all already tcc-probed clean) calls any of them. If a real gcc.exe
# link or a later target-program link finds one missing, that is real,
# correctness-driven signal to add it -- not something to guess ahead of time.
CCLIBGCC2 -DIN_GCC -DCROSS_DIRECTORY_STRUCTURE -DIN_LIBGCC2 -D__GCC_FLOAT_NOT_NEEDED -Dinhibit_libc -D_Complex= -DL_ashldi3 -o lg_ashldi3.o gcc-${version}/gcc/libgcc2.c
CCLIBGCC2 -DIN_GCC -DCROSS_DIRECTORY_STRUCTURE -DIN_LIBGCC2 -D__GCC_FLOAT_NOT_NEEDED -Dinhibit_libc -D_Complex= -DL_ashrdi3 -o lg_ashrdi3.o gcc-${version}/gcc/libgcc2.c
CCLIBGCC2 -DIN_GCC -DCROSS_DIRECTORY_STRUCTURE -DIN_LIBGCC2 -D__GCC_FLOAT_NOT_NEEDED -Dinhibit_libc -D_Complex= -DL_lshrdi3 -o lg_lshrdi3.o gcc-${version}/gcc/libgcc2.c
CCLIBGCC2 -DIN_GCC -DCROSS_DIRECTORY_STRUCTURE -DIN_LIBGCC2 -D__GCC_FLOAT_NOT_NEEDED -Dinhibit_libc -D_Complex= -DL_muldi3 -o lg_muldi3.o gcc-${version}/gcc/libgcc2.c
CCLIBGCC2 -DIN_GCC -DCROSS_DIRECTORY_STRUCTURE -DIN_LIBGCC2 -D__GCC_FLOAT_NOT_NEEDED -Dinhibit_libc -D_Complex= -DL_udivmoddi4 -o lg_udivmoddi4.o gcc-${version}/gcc/libgcc2.c
CCLIBGCC2 -DIN_GCC -DCROSS_DIRECTORY_STRUCTURE -DIN_LIBGCC2 -D__GCC_FLOAT_NOT_NEEDED -Dinhibit_libc -D_Complex= -DL_divdi3 -o lg_divdi3.o gcc-${version}/gcc/libgcc2.c
CCLIBGCC2 -DIN_GCC -DCROSS_DIRECTORY_STRUCTURE -DIN_LIBGCC2 -D__GCC_FLOAT_NOT_NEEDED -Dinhibit_libc -D_Complex= -DL_moddi3 -o lg_moddi3.o gcc-${version}/gcc/libgcc2.c
CCLIBGCC2 -DIN_GCC -DCROSS_DIRECTORY_STRUCTURE -DIN_LIBGCC2 -D__GCC_FLOAT_NOT_NEEDED -Dinhibit_libc -D_Complex= -DL_udivdi3 -o lg_udivdi3.o gcc-${version}/gcc/libgcc2.c
CCLIBGCC2 -DIN_GCC -DCROSS_DIRECTORY_STRUCTURE -DIN_LIBGCC2 -D__GCC_FLOAT_NOT_NEEDED -Dinhibit_libc -D_Complex= -DL_umoddi3 -o lg_umoddi3.o gcc-${version}/gcc/libgcc2.c
CCLIBGCC2 -DIN_GCC -DCROSS_DIRECTORY_STRUCTURE -DIN_LIBGCC2 -D__GCC_FLOAT_NOT_NEEDED -Dinhibit_libc -D_Complex= -DL_cmpdi2 -o lg_cmpdi2.o gcc-${version}/gcc/libgcc2.c
CCLIBGCC2 -DIN_GCC -DCROSS_DIRECTORY_STRUCTURE -DIN_LIBGCC2 -D__GCC_FLOAT_NOT_NEEDED -Dinhibit_libc -D_Complex= -DL_ucmpdi2 -o lg_ucmpdi2.o gcc-${version}/gcc/libgcc2.c
CCLIBGCC2 -DIN_GCC -DCROSS_DIRECTORY_STRUCTURE -DIN_LIBGCC2 -D__GCC_FLOAT_NOT_NEEDED -Dinhibit_libc -D_Complex= -DL_fixunsdfdi -o lg_fixunsdfdi.o gcc-${version}/gcc/libgcc2.c
CCLIBGCC2 -DIN_GCC -DCROSS_DIRECTORY_STRUCTURE -DIN_LIBGCC2 -D__GCC_FLOAT_NOT_NEEDED -Dinhibit_libc -D_Complex= -DL_fixunssfdi -o lg_fixunssfdi.o gcc-${version}/gcc/libgcc2.c
CCLIBGCC2 -DIN_GCC -DCROSS_DIRECTORY_STRUCTURE -DIN_LIBGCC2 -D__GCC_FLOAT_NOT_NEEDED -Dinhibit_libc -D_Complex= -DL_fixdfdi -o lg_fixdfdi.o gcc-${version}/gcc/libgcc2.c
CCLIBGCC2 -DIN_GCC -DCROSS_DIRECTORY_STRUCTURE -DIN_LIBGCC2 -D__GCC_FLOAT_NOT_NEEDED -Dinhibit_libc -D_Complex= -DL_fixsfdi -o lg_fixsfdi.o gcc-${version}/gcc/libgcc2.c
CCLIBGCC2 -DIN_GCC -DCROSS_DIRECTORY_STRUCTURE -DIN_LIBGCC2 -D__GCC_FLOAT_NOT_NEEDED -Dinhibit_libc -D_Complex= -DL_floatdisf -o lg_floatdisf.o gcc-${version}/gcc/libgcc2.c
CCLIBGCC2 -DIN_GCC -DCROSS_DIRECTORY_STRUCTURE -DIN_LIBGCC2 -D__GCC_FLOAT_NOT_NEEDED -Dinhibit_libc -D_Complex= -DL_floatdidf -o lg_floatdidf.o gcc-${version}/gcc/libgcc2.c
CCLIBGCC2 -DIN_GCC -DCROSS_DIRECTORY_STRUCTURE -DIN_LIBGCC2 -D__GCC_FLOAT_NOT_NEEDED -Dinhibit_libc -D_Complex= -DL_floatundisf -o lg_floatundisf.o gcc-${version}/gcc/libgcc2.c
CCLIBGCC2 -DIN_GCC -DCROSS_DIRECTORY_STRUCTURE -DIN_LIBGCC2 -D__GCC_FLOAT_NOT_NEEDED -Dinhibit_libc -D_Complex= -DL_floatundidf -o lg_floatundidf.o gcc-${version}/gcc/libgcc2.c

# __main: real GCC auto-inserts a call to this at the top of every
# compiled main() -- see main-stub.c's own header for why a no-op is the
# honest answer here (no crtbegin/crtend, no __CTOR_LIST__, this
# bootstrap has never had a global-constructor consumer). Found missing
# by this package's own functional test ("unresolved reference to
# '___main'" -- USER_LABEL_PREFIX's own "_" plus __main's own leading
# "_" gives three, see user-label-prefix.patch).
CC -o lg_main-stub.o ${mainStubC}
${ar} rc libgcc.a lg_ashldi3.o lg_ashrdi3.o lg_lshrdi3.o lg_muldi3.o lg_udivmoddi4.o lg_divdi3.o lg_moddi3.o lg_udivdi3.o lg_umoddi3.o lg_cmpdi2.o lg_ucmpdi2.o lg_fixunsdfdi.o lg_fixunssfdi.o lg_fixdfdi.o lg_fixsfdi.o lg_floatdisf.o lg_floatdidf.o lg_floatundisf.o lg_floatundidf.o lg_main-stub.o
# --- archive the static libraries: gmp, mpfr, mpc, libiberty, libcpp,
