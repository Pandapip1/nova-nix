CCGMP -DHAVE_CONFIG_H -o gmp_randsd.o gmp-${gmpVersion}/randsd.c
CCGMP -DHAVE_CONFIG_H -o gmp_randsdui.o gmp-${gmpVersion}/randsdui.c
