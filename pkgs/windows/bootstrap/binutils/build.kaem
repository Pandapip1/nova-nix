# --- run every one of them before installing anything: a binutils that
# cannot say what it is is not a binutils worth handing to the next
# stage. ---
./ar.exe --version
./ranlib.exe --version
./nm.exe --version
./objcopy.exe --version

# And a real round trip, ar and ranlib together, over an object this same
# build already produced: archive it, index it, list it back, copy it
# through objcopy, and read its symbols with nm -- the four programs
# actually agreeing on one file, not four version strings in isolation.
./ar.exe rc selftest.a bu_bucomm.o
./ranlib.exe selftest.a
./ar.exe t selftest.a
./objcopy.exe bu_bucomm.o selftest-copy.o
./nm.exe selftest-copy.o

${bin_mkdir} -p ${out}/bin
${bin_cp} ar.exe ${out}/bin/ar.exe
${bin_cp} ranlib.exe ${out}/bin/ranlib.exe
${bin_cp} nm.exe ${out}/bin/nm.exe
${bin_cp} objcopy.exe ${out}/bin/objcopy.exe
