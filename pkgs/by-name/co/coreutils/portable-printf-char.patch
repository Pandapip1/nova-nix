-#define STRTOX(TYPE, FUNC_NAME, LIB_FUNC_EXPR)				 \
+/* Avoid a direct integer-to-double conversion here.  This bootstrap GCC
+   emits an x87 fild instruction for it, which the bootstrap assembler does
+   not support.  ntlibc's strtod already provides the required conversion. */
+static double
+char_to_double (unsigned char c)
+{
+  char number[4];
+  char *end;
+  number[0] = '0' + c / 100;
+  number[1] = '0' + c / 10 % 10;
+  number[2] = '0' + c % 10;
+  number[3] = 0;
+  return strtod (number, &end);
+}
+
+#define STRTOX(TYPE, FUNC_NAME, LIB_FUNC_EXPR, CHAR_VALUE)		 \
 static TYPE								 \
 FUNC_NAME (s)								 \
