# GNU bash 2.05b, compiled by tcc: the first real shell in the bootstrap.
#
# kaem got this far -- it can run a program and substitute a variable, and
# nothing more.  Everything above wants a shell that has variables, loops,
# conditionals and pipelines, which is what ./configure scripts are written
# in.  This is that shell.
#
# 2.05b rather than anything newer because it is what live-bootstrap made
# build against a C library this small, and the five patches beside it say
# what that took: no locale, no /dev/tty, and a struct field tcc reads
# differently than bash declares it.
#
# The three makefiles are live-bootstrap's, not bash's own: bash's are
# generated by a configure that cannot run here.  config.h and two generated
# headers are made empty, which is what configure would otherwise fill in.
#
# CC and AR are passed rather than left to the makefile, which would look up
# a bare `tcc` on PATH and find the host's if it has one -- a 64-bit tcc
# reading 32-bit objects fails in a way that names the wrong file.

cd ${TMPDIR}
${bin_ungz} --file ${tarball} --output bash.tar
${bin_untar} --file bash.tar
cd bash-${version}

${bin_patch} -Np0 -i ${patch1}
${bin_patch} -Np0 -i ${patch2}
${bin_patch} -Np0 -i ${patch3}
${bin_patch} -Np0 -i ${patch4}
${bin_patch} -Np0 -i ${patch5}

# The archive rule is rewritten as it is copied in: it says `$(AR) cr`, and
# this tcc refuses a flag cluster after -ar -- it scans every argument for the
# operations it does not support, and "-ar" itself contains an 'a'.  With no
# cluster it creates the archive, which is what `cr` asked for.  main.mk says
# it three times over, so replace runs until none is left.
${bin_replace} --file ${mainmk} --output mk1 --match-on ${arPattern} --replace-with ${arReplacement}
${bin_replace} --file mk1 --output mk2 --match-on ${arPattern} --replace-with ${arReplacement}
${bin_replace} --file mk2 --output Makefile --match-on ${arPattern} --replace-with ${arReplacement}
${bin_replace} --file ${builtinsmk} --output builtins/Makefile --match-on ${arPattern} --replace-with ${arReplacement}
${bin_cp} ${commonmk} common.mk
${bin_catm} config.h
${bin_catm} include/version.h
${bin_catm} include/pipesize.h

# mkbuiltins first: it generates the tables the builtins are compiled from.
${bin_make} ${ccflag} ${arflag} mkbuiltins
cd builtins
${bin_make} ${ccflag} ${arflag} libbuiltins.a
cd ..
${bin_make} ${ccflag} ${arflag}

# Check it runs before installing it.
./bash --version

${bin_mkdir} -p ${out}/bin
${bin_cp} bash ${out}/bin/bash
${bin_chmod} 555 ${out}/bin/bash
${bin_cp} bash ${out}/bin/sh
${bin_chmod} 555 ${out}/bin/sh
