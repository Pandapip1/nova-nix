# GNU coreutils 5.0, compiled by tcc and driven by make.
#
# The first build here that uses make rather than a list of compiler calls,
# which is why make came first.  The makefile is not coreutils' own: its
# Makefile.in is generated by a configure this bootstrap cannot run, so
# live-bootstrap wrote a plain one, and that is what is used.
#
# 5.0 rather than anything newer.  Later coreutils want gnulib and a working
# locale; this one wants neither, and the eight patches below are what remain
# after that -- each says something the Mes C library does not have: strcoll,
# mbstate_t, a getdate.c that a modern bison could regenerate.
#
# CC arrives as one variable because kaem substitutes a variable as a single
# argument: written out, `CC=tcc -B .../lib` would reach make as two.

cd ${TMPDIR}
${bin_ungz} --file ${tarball} --output coreutils.tar
${bin_untar} --file coreutils.tar
cd coreutils-${version}

${bin_patch} -Np0 -i ${patch1}
${bin_patch} -Np0 -i ${patch2}
${bin_patch} -Np0 -i ${patch3}
${bin_patch} -Np0 -i ${patch4}
${bin_patch} -Np0 -i ${patch5}
${bin_patch} -Np0 -i ${patch6}
${bin_patch} -Np0 -i ${patch7}
${bin_patch} -Np0 -i ${patch8}

# What ./configure would have written, and the headers it would have named.
${bin_catm} config.h
${bin_cp} lib/fnmatch_.h lib/fnmatch.h
${bin_cp} lib/ftw_.h lib/ftw.h
${bin_cp} lib/search_.h lib/search.h
${bin_rm} src/dircolors.h

# One line of the makefile is adjusted: it archives with `$(AR) cr`, and this
# tcc refuses that.  Mainline tcc scans every argument for the operations it
# does not support -- habdiopN -- and "-ar" itself contains an 'a', so the
# flag cluster is read as a conflicting operation and it prints its usage
# instead.  With no cluster it creates the archive, which is what `cr` asked
# for.  The pattern comes through a variable because kaem would otherwise
# split it on spaces.
${bin_replace} --file ${makefile} --output main.mk --match-on ${arPattern} --replace-with ${arReplacement}

${bin_make} -f main.mk ${ccflag} ${arflag} PREFIX=${out}

# Check one of the programs just built before installing any of them.
./src/echo "Hello coreutils!"

${bin_mkdir} -p ${out}/bin
${bin_make} -f main.mk install ${ccflag} ${arflag} PREFIX=${out}
