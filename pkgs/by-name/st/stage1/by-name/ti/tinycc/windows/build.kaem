# Build an i386-hosted TinyCC whose code generator and linker target x86_64
# PE32+.  The compiler executable itself must remain runnable by the bootstrap;
# ${prevTcc} determines that host format, while TCC_TARGET_X86_64 determines
# the format emitted by the new compiler.

${bin_mkdir} -p ${out}/bin
${bin_mkdir} -p ${out}/lib
${bin_catm} ${out}/bin/config.h

${prevTcc} -B ${prevLibs}/lib -g -v -o ${out}/bin/tcc -U _WIN32 -D __windows__=1 -D BOOTSTRAP=1 -D HAVE_BITFIELD=1 -D HAVE_FLOAT=1 -D HAVE_LONG_LONG=1 -D HAVE_SETJMP=1 -D CONFIG_TCC_PREDEFS=1 -D CONFIG_TCC_SEMLOCK=0 -I ${tccdefs} -I ${out}/bin -I ${src} -D TCC_TARGET_X86_64=1 -D TCC_TARGET_PE=1 -D CONFIG_TCCDIR=\"\" -D CONFIG_SYSROOT=\"\" -D CONFIG_TCC_CRTPREFIX=\"{B}\" -D CONFIG_TCC_ELFINTERP=\"\" -D CONFIG_TCC_LIBPATHS=\"{B}\" -D CONFIG_TCC_SYSINCLUDEPATHS=\"{B}/include\" -D TCC_LIBGCC=\"libc.a\" -D TCC_LIBTCC1=\"libtcc1.a\" -D CONFIG_TCCBOOT=1 -D CONFIG_TCC_STATIC=1 -D CONFIG_USE_LIBGCC=1 -D TCC_MES_LIBC=1 -D TCC_VERSION=\"${version}\" -D ONE_SOURCE=1 -nostdlib ${prevLibs}/lib/crt1.o ${src}/tcc.c -L ${prevLibs}/lib -lc -ltcc1

# Runtime helpers must match the code generator, not the i386 format of the
# compiler executable.  No target libc is needed to compile or archive them.
${out}/bin/tcc -B ${out}/lib -I ${out}/bin -c -D HAVE_CONFIG_H=1 -o libtcc1.o ${src}/lib/libtcc1.c
${out}/bin/tcc -B ${out}/lib -I ${out}/bin -c -o alloca.o ${src}/lib/alloca.S
${out}/bin/tcc -ar ${out}/lib/libtcc1.a libtcc1.o alloca.o
