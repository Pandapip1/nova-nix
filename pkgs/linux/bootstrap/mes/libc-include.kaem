# The headers ./configure would have generated.
#
# Two things, both of which a -I has to be able to find:
#
# mes/config.h, which every Mes source includes and which records how Mes was
# configured.  The only part that matters here is that SYSTEM_LIBC is left
# undefined, so Mes stands on its own C library rather than the host's.
#
# arch/, which is how the C library reaches the headers for the kernel and
# architecture it is being built for: lib/linux/*.c says <arch/syscall.h>, and
# configure copies include/${kernel}/${cpu}/*.h to include/arch/ to answer it.
# There is no ./configure here, so the copy is made directly.

${bin_mkdir} -p ${out}/mes
${bin_mkdir} -p ${out}/arch
${bin_cp} ${configH} ${out}/mes/config.h
${bin_cp} ${src}/include/linux/${arch}/kernel-stat.h ${out}/arch/kernel-stat.h
${bin_cp} ${src}/include/linux/${arch}/signal.h ${out}/arch/signal.h
${bin_cp} ${src}/include/linux/${arch}/syscall.h ${out}/arch/syscall.h
